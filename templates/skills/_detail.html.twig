{% set cap = capabilities[skill.capabilityKey]|default(null) %}
{% set skillColor = cap ? cap.color : '#7C1B7B' %}

<div class="panel-head">
    <button class="panel-close" id="panelClose" type="button" aria-label="Close panel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    {% if fromModule %}
    <button class="panel-back" type="button" data-module-slug="{{ fromModule.slug }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        Back to {{ fromModule.title }}
    </button>
    {% endif %}
    <div class="panel-pills">
        <span class="skill-domain-pill" style="background: {{ skillColor }}">{{ skill.domainName }}</span>
        <span class="cat-pill">{{ skill.ringName }}</span>
    </div>
    <h2 class="panel-title">{{ skill.name }}</h2>
</div>

<div class="panel-body">
    <div class="psec">
        <h3>Proficiency levels</h3>
        <p class="skill-levels-lede">Levels are cumulative — each assumes the ones below it.</p>
        <ul class="skill-levels">
            {% for level in levels %}
            <li class="skill-level" style="--level-color: {{ level.colorHex }}">
                <div class="skill-level-head">
                    <span class="skill-level-num">{{ level.depth }}</span>
                    <span class="skill-level-name">{{ level.name }}</span>
                </div>
                <p class="skill-level-desc">{{ skill.descriptionFor(level.slug) ?? '—' }}</p>
            </li>
            {% endfor %}
        </ul>
    </div>
</div>
