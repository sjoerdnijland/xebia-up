<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Xebia Up — Learning Journey</title>
<style>
    @page { margin: 24mm 18mm 22mm 18mm; }
    body { font-family: Helvetica, Arial, sans-serif; color: #1B0E20; font-size: 11pt; line-height: 1.45; }

    .pdf-head { border-bottom: 2px solid #561257; padding-bottom: 14px; margin-bottom: 22px; }
    .pdf-brand { border-collapse: collapse; }
    .pdf-brand td { vertical-align: middle; padding: 0; }
    .pdf-brand img { height: 30px; width: auto; display: block; }
    .pdf-brand-up { color: #831B84; font-size: 18pt; font-weight: 700; padding-left: 8px; line-height: 30px; }
    .pdf-brand-fallback { color: #561257; font-size: 20pt; font-weight: 700; letter-spacing: -0.01em; line-height: 30px; }
    .pdf-title { font-size: 14pt; font-weight: 700; margin-top: 10px; }
    .pdf-meta { color: #574B5E; font-size: 10pt; margin-top: 4px; }
    .pdf-meta strong { color: #1B0E20; }

    .pdf-empty { color: #574B5E; font-style: italic; padding: 30px 0; text-align: center; }

    /* Journey path table — 2 columns: marker | card.
       The marker column has a right border that draws the continuous
       connecting line through the whole sequence. */
    .path { border-collapse: collapse; width: 100%; }
    .path .marker {
        width: 30pt;
        vertical-align: top;
        padding: 10pt 10pt 14pt 0;
        border-right: 2pt solid #ECE6EE;
    }
    .path .card-cell {
        vertical-align: top;
        padding: 0 0 14pt 12pt;
    }
    .path tr:last-child .marker,
    .path tr:last-child .card-cell { padding-bottom: 0; }

    .step-num {
        display: inline-block;
        width: 28pt; height: 21pt; padding-top: 7pt;
        border-radius: 14pt;
        background: #561257; color: #fff;
        text-align: center; font-weight: 700; font-size: 11pt; line-height: 1;
        margin-right: -16pt; vertical-align: top;
    }

    .card {
        border: 1px solid #ECE6EE;
        border-left: 3pt solid #561257;
        border-radius: 4pt;
        background: #FFFFFF;
        padding: 10pt 12pt 10pt 12pt;
        page-break-inside: avoid;
    }
    .card-tags { margin-bottom: 4pt; font-size: 9pt; }
    .level-chip {
        display: inline-block;
        padding: 1pt 8pt; border-radius: 999pt;
        font-size: 8pt; font-weight: 700; color: #561257;
        background: #F8EFF8; border: 1px solid #B75EB8;
        margin-right: 4pt;
    }
    .cat-chip {
        display: inline-block;
        font-size: 8pt; font-weight: 700; color: #8A8090;
        text-transform: uppercase; letter-spacing: 0.04em;
        margin-right: 6pt;
    }
    .type-chip {
        display: inline-block;
        padding: 1pt 8pt; border-radius: 999pt;
        font-size: 8pt; font-weight: 700;
        border: 1px solid;
    }
    .type-chip--self-paced { color: #2c6e49; border-color: #cce6da; background: #f1f8f4; }
    .type-chip--trainer-led { color: #5a3a72; border-color: #e3d6ea; background: #f8f3fa; }
    .dur-chip {
        display: inline-block;
        padding: 1pt 8pt; border-radius: 999pt;
        font-size: 8pt; font-weight: 600; color: #8A8090;
        border: 1px solid #ECE6EE; background: #FAFAFB;
        margin-right: 4pt;
    }

    .card-title { font-weight: 700; font-size: 11.5pt; margin: 2pt 0 4pt; color: #1B0E20; }
    .card-desc { color: #574B5E; font-size: 10pt; margin: 0 0 6pt; }
    .card-obj { margin: 4pt 0 0 0; padding: 0; list-style: none; font-size: 10pt; color: #1B0E20; }
    .card-obj li { padding: 1pt 0 1pt 12pt; position: relative; }
    .card-obj li::before {
        content: "·"; position: absolute; left: 4pt; color: #831B84; font-weight: 700;
    }
    .card-skills { margin-top: 10pt; padding-top: 8pt; border-top: 1px solid #F0EBF2; }
    .skill {
        display: inline-block;
        padding: 2pt 8pt 2pt 6pt; margin: 1pt 4pt 1pt 0;
        border-radius: 999pt;
        border: 1px solid #ECE6EE; background: #FAFAFB;
        font-size: 9pt; color: #1B0E20;
    }
    .skill-dot {
        display: inline-block;
        width: 6pt; height: 6pt; border-radius: 3pt;
        margin-right: 5pt; vertical-align: middle;
        background: #7C1B7B;
    }

    .pdf-foot {
        position: fixed; bottom: -14mm; left: 0; right: 0;
        text-align: center; color: #8A8090; font-size: 8pt;
    }
</style>
</head>
<body>

<div class="pdf-head">
    <table class="pdf-brand"><tr>
        <td>
            {% if logoSrc %}<img src="{{ logoSrc }}" alt="Xebia">{% else %}<span class="pdf-brand-fallback">Xebia</span>{% endif %}
        </td>
        <td><span class="pdf-brand-up">Up</span></td>
    </tr></table>
    <div class="pdf-title">Learning Journey</div>
    <div class="pdf-meta">
        {% if clientName %}<strong>{{ clientName }}</strong>{% endif %}
        {% if roleName %}{% if clientName %} · {% endif %}<strong>{{ roleName }}</strong>{% endif %}
        {% if audience|default('') %} · for <strong>{{ audience }}</strong>{% endif %}
        {% if clientName or roleName or audience %} · {% endif %}
        {% set totalHours = 0 %}{% for m in modulesInOrder %}{% set totalHours = totalHours + m.durationHours %}{% endfor %}
        {% if totalHours % 8 == 0 %}{% set totalDuration = (totalHours / 8) ~ ' day' ~ (totalHours / 8 != 1 ? 's' : '') %}{% else %}{% set totalDuration = totalHours ~ ' hours' %}{% endif %}
        {{ generatedAt|date('j M Y') }} · {{ totalSelected }} step{% if totalSelected != 1 %}s{% endif %} · {{ totalDuration }}
    </div>
</div>

{% if totalSelected == 0 %}
<div class="pdf-empty">No modules selected.</div>
{% else %}
<table class="path">
    {% for module in modulesInOrder %}
    {% set category = module.categories.first %}
    {% set firstCap = module.skills|length > 0 ? capabilities[module.skills|first.capabilityKey]|default(null) : null %}
    {% set accent = firstCap ? firstCap.color : '#561257' %}
    <tr>
        <td class="marker">
            <span class="step-num" style="background: {{ accent }};">{{ loop.index }}</span>
        </td>
        <td class="card-cell">
            <div class="card" style="border-left-color: {{ accent }};">
                <div class="card-tags">
                    <span class="level-chip"
                          style="color: {{ module.level.colorHex }}; background: {{ module.level.tintHex }}; border-color: {{ module.level.colorHex }};">
                        L{{ module.level.depth }} · {{ module.level.name }}
                    </span>
                    {% if category %}
                    <span class="cat-chip">{{ category.name }}</span>
                    {% endif %}
                    {% if module.type %}
                    <span class="type-chip type-chip--{{ module.type.slug }}">{{ module.type.name }}</span>
                    {% endif %}
                    <span class="dur-chip">{{ module.formattedDuration }}</span>
                </div>
                <div class="card-title">{{ module.title }}</div>
                <div class="card-desc">{{ module.description }}</div>
                {% if module.objectives|length > 0 %}
                <ul class="card-obj">
                    {% for obj in module.objectives %}
                    <li>{{ obj.text }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
                {% if module.skills|length > 0 %}
                <div class="card-skills">
                    {% for skill in module.skills %}
                    {% set cap = capabilities[skill.capabilityKey]|default(null) %}
                    {% set skillColor = cap ? cap.color : '#7C1B7B' %}
                    <span class="skill"><span class="skill-dot" style="background: {{ skillColor }};"></span>{{ skill.name }}</span>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </td>
    </tr>
    {% endfor %}
</table>
{% endif %}

<div class="pdf-foot">Xebia Up — Composed learning journey</div>

</body>
</html>
