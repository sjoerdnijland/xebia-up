<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Xebia Up — Learning Journey</title>
<style>
    @page { margin: 24mm 18mm 22mm 18mm; }
    body { font-family: Helvetica, Arial, sans-serif; color: #1B0E20; font-size: 11pt; line-height: 1.45; }

    .pdf-head { border-bottom: 2px solid #561257; padding-bottom: 14px; margin-bottom: 18px; }
    .pdf-brand { border-collapse: collapse; }
    .pdf-brand td { vertical-align: middle; padding: 0; }
    .pdf-brand img { height: 30px; width: auto; display: block; }
    .pdf-brand-up { color: #831B84; font-size: 18pt; font-weight: 700; padding-left: 8px; line-height: 30px; }
    .pdf-brand-fallback { color: #561257; font-size: 20pt; font-weight: 700; letter-spacing: -0.01em; line-height: 30px; }
    .pdf-title { font-size: 14pt; font-weight: 700; margin-top: 10px; }
    .pdf-meta { color: #574B5E; font-size: 10pt; margin-top: 4px; }
    .pdf-meta strong { color: #1B0E20; }

    .pdf-empty { color: #574B5E; font-style: italic; padding: 30px 0; text-align: center; }

    .cat { margin-top: 22px; }
    .cat-head {
        font-size: 12pt; font-weight: 700; color: #561257;
        border-bottom: 1px solid #ECE6EE;
        padding-bottom: 4px; margin-bottom: 10px;
    }
    .cat-tag { color: #8A8090; font-weight: 400; font-size: 9pt; margin-left: 8px; }

    .mod { padding: 10px 0 12px; border-bottom: 1px solid #F0EBF2; page-break-inside: avoid; }
    .mod:last-child { border-bottom: 0; }
    .mod-head { margin-bottom: 4px; }
    .mod-num {
        display: inline-block; width: 22px;
        color: #8A8090; font-weight: 700; font-size: 10pt;
    }
    .mod-title { font-weight: 700; font-size: 11pt; }
    .mod-level {
        display: inline-block; margin-left: 8px;
        padding: 1px 8px; border-radius: 999px;
        font-size: 8pt; font-weight: 700; color: #561257;
        background: #F8EFF8; border: 1px solid #B75EB8;
    }
    .mod-type {
        display: inline-block; margin-left: 6px;
        padding: 1px 8px; border-radius: 999px;
        font-size: 8pt; font-weight: 700;
        border: 1px solid;
    }
    .mod-type--self-paced { color: #2c6e49; border-color: #cce6da; background: #f1f8f4; }
    .mod-type--trainer-led { color: #5a3a72; border-color: #e3d6ea; background: #f8f3fa; }
    .mod-desc { color: #574B5E; font-size: 10pt; margin: 4px 0 6px 22px; }
    .mod-obj { margin: 0 0 0 22px; padding: 0; list-style: none; font-size: 10pt; color: #1B0E20; }
    .mod-obj li { padding: 1px 0 1px 14px; position: relative; }
    .mod-obj li::before {
        content: "·";
        position: absolute; left: 4px; color: #831B84; font-weight: 700;
    }

    .pdf-foot {
        position: fixed; bottom: -14mm; left: 0; right: 0;
        text-align: center; color: #8A8090; font-size: 8pt;
    }
</style>
</head>
<body>

<div class="pdf-head">
    <table class="pdf-brand"><tr>
        <td>
            {% if logoSrc %}<img src="{{ logoSrc }}" alt="Xebia">{% else %}<span class="pdf-brand-fallback">Xebia</span>{% endif %}
        </td>
        <td><span class="pdf-brand-up">Up</span></td>
    </tr></table>
    <div class="pdf-title">Learning Journey</div>
    <div class="pdf-meta">
        {% if clientName %}<strong>{{ clientName }}</strong>{% endif %}
        {% if roleName %}{% if clientName %} · {% endif %}<strong>{{ roleName }}</strong>{% endif %}
        {% if clientName or roleName %} · {% endif %}
        {{ generatedAt|date('j M Y') }} · {{ totalSelected }} module{% if totalSelected != 1 %}s{% endif %}
    </div>
</div>

{% if totalSelected == 0 %}
<div class="pdf-empty">No modules selected.</div>
{% else %}
    {% set modNum = 0 %}
    {% for category in categories %}
        {% set mods = byCategory[category.slug] | default([]) %}
        {% if mods is not empty %}
        <div class="cat">
            <div class="cat-head">
                {{ category.name }}
                <span class="cat-tag">{{ category.tag }} · {{ mods|length }} module{% if mods|length != 1 %}s{% endif %}</span>
            </div>
            {% for module in mods %}
                {% set modNum = modNum + 1 %}
                <div class="mod">
                    <div class="mod-head">
                        <span class="mod-num">{{ modNum }}.</span>
                        <span class="mod-title">{{ module.title }}</span>
                        <span class="mod-level">Level {{ module.level.depth }} · {{ module.level.name }}</span>
                        {% if module.type %}
                        <span class="mod-type mod-type--{{ module.type.slug }}">{{ module.type.name }}</span>
                        {% endif %}
                    </div>
                    <div class="mod-desc">{{ module.description }}</div>
                    {% if module.objectives|length > 0 %}
                    <ul class="mod-obj">
                        {% for obj in module.objectives %}
                        <li>{{ obj.text }}</li>
                        {% endfor %}
                    </ul>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
        {% endif %}
    {% endfor %}
{% endif %}

<div class="pdf-foot">Xebia Up — Composed learning journey</div>

</body>
</html>
