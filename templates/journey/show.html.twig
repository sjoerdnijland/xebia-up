{% extends 'base.html.twig' %}

{% set activeCategory = category.slug %}

{% block title %}{{ category.name }} Learning Journey — Xebia Up{% endblock %}

{% block body %}
{% if capabilities|default([])|length > 0 %}
<section class="model-intro">
    <div class="model-intro-copy">
        <div class="eyebrow">One model, one language</div>
        <h1 class="model-intro-title">Build your AI learning journey</h1>
        <p class="model-intro-lede">
            A durable human core, the capabilities for working and leading with AI, and three cross-cutting
            capabilities — shown as arrows — that run through everything. Every training module maps to the
            model — so a learner can see exactly which capabilities a session grows. The colours below key
            every module and journey.
        </p>
        <ul class="model-legend">
            {% for key, cap in capabilities %}
            <li class="model-legend-item">
                <span class="model-legend-swatch" style="background: {{ cap.color }}"></span>
                <span class="model-legend-label">
                    {{ cap.name }}{% if cap.kind == 'enabler' %} <span class="model-legend-kind">· enabler</span>{% endif %}
                </span>
            </li>
            {% endfor %}
        </ul>
    </div>
    <div class="model-intro-wheel">
        <img src="/img/skills-capabilities-wheel.svg"
             alt="AI Skills &amp; Capabilities wheel"
             width="520" height="520"
             loading="lazy">
    </div>
</section>
{% endif %}

<div class="layout">
    <aside class="filters" aria-label="Filters">
        <form method="get" action="{{ path('journey_show', {category: category.slug}) }}"
              class="filters-form" data-filter-form>
            <div class="filters-head">
                <h2 class="filters-title">Filters</h2>
                {% if filtersActive %}
                <a class="filters-clear" href="{{ path('journey_show', {category: category.slug}) }}">Clear</a>
                {% endif %}
            </div>

            {% if capabilities|length > 0 %}
            <details class="filter-section" open>
                <summary class="filter-section-title">Skill area</summary>
                <ul class="filter-list">
                    {% for key, cap in capabilities %}
                    {% set checked = key in activeCapabilities %}
                    <li class="filter-row">
                        <label class="filter-check">
                            <input type="checkbox" name="capability[]" value="{{ key }}"
                                   {% if checked %}checked{% endif %}>
                            <span class="filter-box" aria-hidden="true"></span>
                            <span class="filter-swatch" style="background: {{ cap.color }}"></span>
                            <span class="filter-label">{{ cap.tag }}</span>
                            <span class="filter-count">{{ capabilityCounts[key]|default(0) }}</span>
                        </label>
                    </li>
                    {% endfor %}
                </ul>
            </details>
            {% endif %}

            <details class="filter-section" open>
                <summary class="filter-section-title">Session type</summary>
                <ul class="filter-list">
                    {% for type in types %}
                    {% set checked = type.slug in activeTypes %}
                    <li class="filter-row">
                        <label class="filter-check">
                            <input type="checkbox" name="type[]" value="{{ type.slug }}"
                                   {% if checked %}checked{% endif %}>
                            <span class="filter-box" aria-hidden="true"></span>
                            <span class="filter-label">{{ type.name }}</span>
                            <span class="filter-count">{{ typeCounts[type.slug]|default(0) }}</span>
                        </label>
                    </li>
                    {% endfor %}
                </ul>
            </details>

            <details class="filter-section" open>
                <summary class="filter-section-title">Role</summary>
                <ul class="filter-list">
                    {% for role in roles %}
                    {% set checked = role.slug in activeRoles %}
                    <li class="filter-row">
                        <label class="filter-check">
                            <input type="checkbox" name="role[]" value="{{ role.slug }}"
                                   {% if checked %}checked{% endif %}>
                            <span class="filter-box" aria-hidden="true"></span>
                            <span class="filter-label">{{ role.name }}</span>
                            <span class="filter-count">{{ roleCounts[role.slug]|default(0) }}</span>
                        </label>
                    </li>
                    {% endfor %}
                </ul>
            </details>

            <details class="filter-section" open>
                <summary class="filter-section-title">Level</summary>
                <ul class="filter-list">
                    {% for level in levels %}
                    {% set checked = level.slug in activeLevels %}
                    <li class="filter-row">
                        <label class="filter-check">
                            <input type="checkbox" name="level[]" value="{{ level.slug }}"
                                   {% if checked %}checked{% endif %}>
                            <span class="filter-box" aria-hidden="true"></span>
                            <span class="filter-label">{{ level.name }}</span>
                            <span class="filter-count">{{ levelCounts[level.slug]|default(0) }}</span>
                        </label>
                    </li>
                    {% endfor %}
                </ul>
            </details>

            <noscript>
                <button type="submit" class="filters-apply">Apply</button>
            </noscript>
        </form>
    </aside>

<div class="pathway">
    <div class="path-head">
        <div class="path-avatar path-avatar--all">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
        </div>
        <div>
            <h2>{% if filtersActive %}Filtered modules{% else %}All modules{% endif %}</h2>
            <p>
                {% if filtersActive %}
                    {{ totalModules }} module{% if totalModules != 1 %}s{% endif %} match the selected filters.
                {% else %}
                    {{ totalModules }} skill-centric module{% if totalModules != 1 %}s{% endif %} across four levels. Use the filters to focus on a role, skill area or level.
                {% endif %}
            </p>
        </div>
    </div>

    {% for level in levels %}
    {% set mods = byLevel[level.slug]|default([]) %}
    {% if mods|length > 0 or not filtersActive %}
    <div class="path-level">
        <div class="level-rail">
            <div class="level-n">Level {{ level.depth }}</div>
            <div class="level-name">{{ level.name }}</div>
            <div class="level-spine" style="background: {{ level.colorHex }}"></div>
            <div class="level-blurb">{{ level.blurb }}</div>
        </div>
        <div class="level-cards">
            {% if mods|length == 0 %}
            <div class="level-empty">No modules at this level{% if filtersActive %} match the filters{% endif %} yet.</div>
            {% else %}
            {% for module in mods %}
            {% set nextSession = module.nextSession %}
            {% set isSelected = journey.isSelected(module.slug) %}
            {% set capKey = moduleCapabilities[module.slug]|default(null) %}
            {% set mcardCap = capKey and capabilities[capKey] is defined ? capabilities[capKey] : null %}
            <div class="mcard-wrap{% if journey.on %} mcard-wrap--ic{% endif %}{% if journey.on and isSelected %} mcard-wrap--selected{% endif %}">
                <button class="mcard" data-module-slug="{{ module.slug }}" type="button"{% if mcardCap %} style="--cap-color: {{ mcardCap.color }}"{% endif %}>
                    <span class="mcard-tags">
                        {% if module.isForAllRoles(totalRoles) %}
                        <span class="core-badge">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                            Core for everyone
                        </span>
                        {% else %}
                        <span class="role-tags">
                            {% for role in module.roles %}
                            <span class="rtag {% if role.slug in activeRoles %}rtag--active{% endif %}">{{ role.shortCode }}</span>
                            {% endfor %}
                        </span>
                        {% endif %}
                    </span>
                    <span class="mcard-title">{{ module.title }}</span>
                    {% if mcardCap %}
                    <span class="cap-tag cap-tag--{{ mcardCap.kind }}"
                          style="--cap-color: {{ mcardCap.color }}"
                          title="{{ mcardCap.name }}">
                        <span class="cap-tag-dot" aria-hidden="true"></span>
                        <span class="cap-tag-label">{{ mcardCap.tag }}</span>
                    </span>
                    {% endif %}
                    {% if module.type %}
                    <span class="mtype-label mtype-label--{{ module.type.slug }}">{{ module.type.name }}</span>
                    {% endif %}
                    <span class="mcard-desc">{{ module.description }}</span>
                    {% if not journey.on and nextSession %}
                    <span class="mcard-meta">
                        <span class="mcard-date">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            {{ nextSession.startsAt|date('j M') }}
                        </span>
                        {% set seatsLeft = nextSession.seatsLeft %}
                        <span class="seat-indicator">
                            {% if seatsLeft == 0 %}
                            <span class="seat-dot seat-dot--full"></span>Full
                            {% elseif seatsLeft <= 3 %}
                            <span class="seat-dot seat-dot--low"></span>{{ seatsLeft }} left
                            {% else %}
                            <span class="seat-dot seat-dot--ok"></span>{{ seatsLeft }} left
                            {% endif %}
                        </span>
                    </span>
                    {% endif %}
                </button>
                {% if journey.on %}
                <form method="post"
                      action="{{ path(isSelected ? 'journey_deselect' : 'journey_select') }}"
                      class="mcard-select-form"
                      data-select-form>
                    <input type="hidden" name="slug" value="{{ module.slug }}">
                    <input type="hidden" name="_next" value="{{ app.request.requestUri }}">
                    <button type="submit"
                            class="mcard-select{% if isSelected %} mcard-select--on{% endif %}"
                            data-select-button
                            data-slug="{{ module.slug }}"
                            aria-pressed="{{ isSelected ? 'true' : 'false' }}">
                        {% if isSelected %}
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                            <span class="mcard-select-label">Selected</span>
                        {% else %}
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                            <span class="mcard-select-label">Add to journey</span>
                        {% endif %}
                    </button>
                </form>
                {% endif %}
            </div>
            {% endfor %}
            {% endif %}
        </div>
    </div>
    {% endif %}
    {% endfor %}
</div>
</div>
{% endblock %}
